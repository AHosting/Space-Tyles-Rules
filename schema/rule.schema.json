{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Context Hypervisor rule",
  "description": "A rule is data, never code. See docs/RULE_FORMAT.md. The extension re-checks every rule it installs, including the safety rules that JSON Schema cannot express (read-only GraphQL, regex safety, no variable cycles).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "minEngine",
    "name",
    "description",
    "domains",
    "text"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+/[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "minEngine": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "author": {
      "type": "string",
      "maxLength": 80
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^(\\*|[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+)$"
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,30}$"
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pathRegex": {
          "type": "string",
          "maxLength": 300
        },
        "hint": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/definitions/input"
      }
    },
    "requests": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/request"
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/variable"
      }
    },
    "text": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      ]
    }
  },
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "type"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^\\w+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "text",
            "textarea",
            "select"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "placeholder": {
          "type": "string"
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "default": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^/(?!/)"
        },
        "query": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "numericVars": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "hidden": {
          "type": "boolean"
        },
        "transform": {
          "enum": [
            "htmlToText",
            "round2",
            "slugToTitle",
            "trim",
            "stripLineNumbers"
          ]
        },
        "map": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "maxChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500000
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/source"
          }
        },
        "fallback": {
          "$ref": "#/definitions/fallback"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from"
      ],
      "properties": {
        "from": {
          "enum": [
            "url",
            "css",
            "graphql",
            "var",
            "format",
            "input",
            "literal",
            "harvest",
            "pdf"
          ]
        },
        "regex": {
          "type": "string",
          "maxLength": 300
        },
        "selector": {
          "type": "string",
          "maxLength": 300
        },
        "attr": {
          "type": "string"
        },
        "request": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "frames": {
          "type": "boolean"
        },
        "driver": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+/[a-z0-9-]+$",
          "description": "For a harvest source: the id of the declarative driver whose collected text to read."
        },
        "pages": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^(all|\\s*\\d*\\s*-?\\s*\\d*\\s*(,\\s*\\d*\\s*-?\\s*\\d*\\s*)*)$",
          "description": "For a pdf source: which pages to read, one-based and inclusive, e.g. \"3\", \"2-7\", \"1-3,9,20-\" or \"all\"."
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "type": {
          "enum": [
            "text",
            "textarea"
          ]
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "placeholder": {
          "type": "string",
          "maxLength": 200
        },
        "hint": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
