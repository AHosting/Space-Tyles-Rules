{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Context Hypervisor rule",
  "description": "A rule is data, never code. See docs/RULE_FORMAT.md. The extension re-checks every rule it installs, including the safety rules that JSON Schema cannot express (read-only GraphQL, regex safety, no variable cycles).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "minEngine",
    "name",
    "description",
    "domains",
    "text"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+/[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "minEngine": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "author": {
      "type": "string",
      "maxLength": 80
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^(\\*|[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+)$"
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,30}$"
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pathRegex": {
          "type": "string",
          "maxLength": 300
        },
        "hint": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/definitions/input"
      }
    },
    "requests": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/request"
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/variable"
      }
    },
    "text": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      ]
    }
  },
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "type"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^\\w+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "text",
            "textarea",
            "select"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "placeholder": {
          "type": "string"
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "default": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "grab": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sources"
          ],
          "description": "Where this input's value can be read from the page, so it need not be typed.",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 40
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "$ref": "#/definitions/source"
              }
            },
            "hover": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "over",
                "sources"
              ],
              "description": "Read it from under the pointer instead, for a value that only exists while hovering.",
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 40
                },
                "over": {
                  "type": "string",
                  "maxLength": 300
                },
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "items": {
                    "$ref": "#/definitions/source"
                  }
                }
              }
            }
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^/(?!/)"
        },
        "query": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "numericVars": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "hidden": {
          "type": "boolean"
        },
        "transform": {
          "enum": [
            "htmlToText",
            "round2",
            "slugToTitle",
            "trim",
            "stripLineNumbers"
          ]
        },
        "map": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "maxChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500000
        },
        "timeSlice": {
          "description": "Engine 7. Keeps only the part of a timestamped text between two times, padded. `from` and `to` name OTHER VARIABLES holding the bounds, not the times themselves, so a bound can come from a form field or from the page. Applied before maxChars: capping first would discard minute 70 and then look for it.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from"
          ],
          "properties": {
            "from": {
              "description": "The variable holding the start time.",
              "type": "string",
              "minLength": 1
            },
            "to": {
              "description": "The variable holding the end time. Without it, `after` decides how far to read.",
              "type": "string"
            },
            "before": {
              "description": "Seconds of context kept before the start.",
              "type": "integer",
              "minimum": 0,
              "maximum": 7200
            },
            "after": {
              "description": "Seconds of context kept after the end.",
              "type": "integer",
              "minimum": 0,
              "maximum": 7200
            },
            "stamp": {
              "description": "How a timestamp is recognised in the text. Defaults to h:mm / h:mm:ss.",
              "type": "string"
            },
            "separator": {
              "description": "What divides one timestamped chunk from the next. Defaults to a blank line.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/source"
          }
        },
        "fallback": {
          "$ref": "#/definitions/fallback"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from"
      ],
      "properties": {
        "from": {
          "enum": [
            "url",
            "css",
            "graphql",
            "var",
            "format",
            "input",
            "literal",
            "harvest",
            "pdf",
            "collected"
          ]
        },
        "regex": {
          "type": "string",
          "maxLength": 300
        },
        "selector": {
          "type": "string",
          "maxLength": 300
        },
        "attr": {
          "type": "string"
        },
        "request": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "frames": {
          "type": "boolean"
        },
        "driver": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+/[a-z0-9-]+$",
          "description": "For a harvest source: the id of the declarative driver whose collected text to read."
        },
        "pages": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^(all|\\s*\\d*\\s*-?\\s*\\d*\\s*(,\\s*\\d*\\s*-?\\s*\\d*\\s*)*)$",
          "description": "For a pdf source: which pages to read, one-based and inclusive, e.g. \"3\", \"2-7\", \"1-3,9,20-\" or \"all\"."
        },
        "separator": {
          "description": "Engine 8, `collected` sources only. What divides one collected item from the next. Defaults to a horizontal rule on its own line, because these are distinct things the user chose one at a time, not a passage.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "type": {
          "enum": [
            "text",
            "textarea"
          ]
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "placeholder": {
          "type": "string",
          "maxLength": 200
        },
        "hint": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
