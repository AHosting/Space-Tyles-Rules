{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ahosting.github.io/Space-Tyles-Rules/schema/driver.schema.json",
  "title": "Context Hypervisor page driver",
  "description": "A driver is DATA that parameterises the extension's one fixed harvest engine. It can scroll, collect and - with a required text constraint - click. It cannot carry code, which is what lets this schema and the shared validator decide whether it is safe before it runs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "minEngine", "name", "description", "domains", "harvest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9.-]+/[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "minEngine": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 400 },
    "author": { "type": "string", "maxLength": 80 },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "pattern": "^[a-z0-9-]{1,30}$" }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pathRegex": { "type": "string", "maxLength": 300 },
        "hint": { "type": "string", "maxLength": 400 }
      }
    },
    "harvest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item"],
      "properties": {
        "item": { "type": "string", "minLength": 1, "maxLength": 300 },
        "key": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "selector": { "type": "string", "minLength": 1, "maxLength": 300 },
            "attr": { "type": "string", "minLength": 1, "maxLength": 80 },
            "regex": { "type": "string", "maxLength": 300 }
          }
        },
        "scroll": { "type": "string", "minLength": 1, "maxLength": 300 },
        "maxPasses": { "type": "integer", "minimum": 1, "maximum": 200 },
        "settleMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "stopAfterQuietPasses": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "maxMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "expand": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selector", "textMatches"],
          "description": "textMatches is required: a click with no stated constraint on what it lands on is the one thing in this schema that could do something irreversible.",
          "properties": {
            "selector": { "type": "string", "minLength": 1, "maxLength": 300 },
            "textMatches": { "type": "string", "minLength": 1, "maxLength": 300 },
            "within": { "type": "string", "minLength": 1, "maxLength": 300 },
            "maxClicks": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        }
      }
    }
  }
}
