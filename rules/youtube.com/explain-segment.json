{
  "schemaVersion": 1,
  "id": "youtube.com/explain-segment",
  "version": 6,
  "minEngine": 7,
  "name": "Explain this part of the video",
  "description": "Explains a stretch of a YouTube video from its transcript. Leave the times blank and it uses wherever you have paused. Needs the youtube.com/transcript driver, or the transcript panel open.",
  "author": "you",
  "domains": [
    "youtube.com",
    "www.youtube.com"
  ],
  "tags": [
    "video",
    "transcript",
    "explain"
  ],
  "match": {
    "pathRegex": "^/watch",
    "hint": "Written for a YouTube video page. Anywhere else, paste the transcript in below."
  },
  "inputs": [
    {
      "key": "from",
      "label": "From (optional)",
      "type": "text",
      "required": false,
      "placeholder": "12:30 — or press a button, or leave blank for where you are",
      "grab": {
        "label": "Use where I am",
        "sources": [
          {
            "from": "css",
            "selector": ".ytp-time-current",
            "regex": "(\\d{1,2}:\\d{2}(?::\\d{2})?)"
          },
          {
            "from": "css",
            "selector": ".ytp-progress-bar",
            "attr": "aria-valuetext"
          }
        ],
        "hover": {
          "label": "Pick on the scrub bar",
          "over": ".ytp-progress-bar-container, .ytp-progress-bar",
          "sources": [
            {
              "from": "css",
              "selector": ".ytp-tooltip-text",
              "regex": "(\\d{1,2}:\\d{2}(?::\\d{2})?)"
            },
            {
              "from": "css",
              "selector": ".ytp-tooltip-title",
              "regex": "(\\d{1,2}:\\d{2}(?::\\d{2})?)"
            },
            {
              "from": "css",
              "selector": ".ytp-tooltip",
              "regex": "(\\d{1,2}:\\d{2}(?::\\d{2})?)"
            }
          ]
        }
      }
    },
    {
      "key": "to",
      "label": "To (optional)",
      "type": "text",
      "required": false,
      "placeholder": "15:00 — hovering the scrub bar picks this without seeking",
      "grab": {
        "label": "Use where I am",
        "sources": [
          {
            "from": "css",
            "selector": ".ytp-time-current",
            "regex": "(\\d{1,2}:\\d{2}(?::\\d{2})?)"
          },
          {
            "from": "css",
            "selector": ".ytp-progress-bar",
            "attr": "aria-valuetext"
          }
        ],
        "hover": {
          "label": "Pick on the scrub bar",
          "over": ".ytp-progress-bar-container, .ytp-progress-bar",
          "sources": [
            {
              "from": "css",
              "selector": ".ytp-tooltip-text",
              "regex": "(\\d{1,2}:\\d{2}(?::\\d{2})?)"
            },
            {
              "from": "css",
              "selector": ".ytp-tooltip-title",
              "regex": "(\\d{1,2}:\\d{2}(?::\\d{2})?)"
            },
            {
              "from": "css",
              "selector": ".ytp-tooltip",
              "regex": "(\\d{1,2}:\\d{2}(?::\\d{2})?)"
            }
          ]
        }
      }
    },
    {
      "key": "depth",
      "label": "What do you want",
      "type": "select",
      "default": "explain",
      "options": [
        {
          "value": "explain",
          "label": "Explain it — what is being said, and why"
        },
        {
          "value": "define",
          "label": "Define it — the terms and names used"
        },
        {
          "value": "verify",
          "label": "Check it — is the claim sound"
        },
        {
          "value": "notes",
          "label": "Notes — the points, as a list"
        }
      ]
    },
    {
      "key": "question",
      "label": "Anything specific to ask (optional)",
      "type": "textarea",
      "rows": 2,
      "required": false,
      "placeholder": "What did they mean by “the bitter lesson”?"
    }
  ],
  "variables": {
    "transcript": {
      "sources": [
        {
          "from": "harvest",
          "driver": "youtube.com/transcript"
        },
        {
          "from": "css",
          "selector": "ytd-transcript-segment-renderer"
        },
        {
          "from": "css",
          "selector": "#segments-container"
        },
        {
          "from": "css",
          "selector": "ytd-transcript-segment-list-renderer"
        },
        {
          "from": "css",
          "selector": "ytd-transcript-renderer"
        }
      ],
      "maxChars": 200000,
      "fallback": {
        "label": "The transcript",
        "type": "textarea",
        "rows": 8,
        "placeholder": "Paste the transcript",
        "hint": "Open “...more” under the video, then “Show transcript”, then press ↻ at the top of this panel. If it still asks, the transcript panel is not where this rule expects — use 🧪 Build a rule to find it."
      },
      "timeSlice": {
        "from": "sliceFrom",
        "to": "sliceTo",
        "before": 60,
        "after": 120
      }
    },
    "nowAt": {
      "sources": [
        {
          "from": "css",
          "selector": ".ytp-time-current"
        },
        {
          "from": "css",
          "selector": ".ytp-progress-bar",
          "attr": "aria-valuetext"
        },
        {
          "from": "css",
          "selector": "video",
          "attr": "currentTime"
        },
        {
          "from": "url",
          "regex": "[?&]t=(\\d+)"
        },
        {
          "from": "literal",
          "value": "the start"
        }
      ]
    },
    "duration": {
      "sources": [
        {
          "from": "css",
          "selector": ".ytp-time-duration"
        },
        {
          "from": "css",
          "selector": "meta[itemprop=\"duration\"]",
          "attr": "content"
        },
        {
          "from": "literal",
          "value": "unknown"
        }
      ]
    },
    "title": {
      "sources": [
        {
          "from": "css",
          "selector": "h1.ytd-watch-metadata"
        },
        {
          "from": "css",
          "selector": "meta[name=\"title\"]",
          "attr": "content"
        },
        {
          "from": "css",
          "selector": "h1"
        }
      ],
      "maxChars": 300,
      "fallback": {
        "label": "The video's title",
        "type": "text",
        "placeholder": "Paste the title"
      }
    },
    "channel": {
      "sources": [
        {
          "from": "css",
          "selector": "ytd-channel-name #text"
        },
        {
          "from": "css",
          "selector": "#owner #channel-name"
        },
        {
          "from": "css",
          "selector": "link[itemprop=\"name\"]",
          "attr": "content"
        },
        {
          "from": "literal",
          "value": "unknown"
        }
      ],
      "maxChars": 200
    },
    "videoUrl": {
      "sources": [
        {
          "from": "url",
          "regex": "(https://[^&]*v=[A-Za-z0-9_-]+)"
        },
        {
          "from": "url",
          "regex": "(.+)"
        },
        {
          "from": "literal",
          "value": "not given"
        }
      ]
    },
    "from": {
      "sources": [
        {
          "from": "input",
          "name": "from"
        },
        {
          "from": "literal",
          "value": "(not given)"
        }
      ]
    },
    "to": {
      "sources": [
        {
          "from": "input",
          "name": "to"
        },
        {
          "from": "literal",
          "value": "(not given)"
        }
      ]
    },
    "depth": {
      "sources": [
        {
          "from": "input",
          "name": "depth"
        }
      ]
    },
    "question": {
      "sources": [
        {
          "from": "input",
          "name": "question"
        },
        {
          "from": "literal",
          "value": "(they did not ask one)"
        }
      ]
    },
    "sliceFrom": {
      "hidden": true,
      "sources": [
        {
          "from": "input",
          "name": "from",
          "regex": "(\\d{1,2}:\\d{2}(?::\\d{2})?)"
        },
        {
          "from": "var",
          "name": "nowAt",
          "regex": "(\\d{1,2}:\\d{2}(?::\\d{2})?)"
        },
        {
          "from": "literal",
          "value": "0:00"
        }
      ]
    },
    "sliceTo": {
      "hidden": true,
      "sources": [
        {
          "from": "input",
          "name": "to",
          "regex": "(\\d{1,2}:\\d{2}(?::\\d{2})?)"
        }
      ]
    }
  },
  "text": [
    "You are watching a video with someone and they have stopped to ask about a particular stretch of it.",
    "",
    "WHAT YOU HAVE BEEN GIVEN",
    "- Only the transcript of the stretch they asked about, plus about a minute of run-up before it so that a pronoun or a term has its referent. It is not the whole video.",
    "- They asked for: {{from}} to {{to}}. Where those are blank, the stretch was taken from where they are paused, {{nowAt}} of {{duration}}.",
    "- Say at the top which stretch you read, as a range.",
    "- If something in it plainly refers back to a part of the video you have not been given, say so rather than guessing at it. That is the one thing this cannot show you.",
    "",
    "WHAT THEY WANT: {{depth}}",
    "- explain: say what is being argued or shown, and why it follows from what came before. Lead with one sentence that would let someone who missed it carry on watching.",
    "- define: pick out the terms, names, products and jargon used here and define each one briefly, in the sense the speaker is using it.",
    "- verify: state the claim as precisely as the transcript allows, then say what would have to be true for it to hold, and what the speaker does not establish. Be clear about the difference between “this is wrong” and “this is not supported here”.",
    "- notes: the points made, as a short list, each with its timestamp.",
    "",
    "RULES",
    "- Work only from the transcript below. If something is not in it, say so rather than supplying it from general knowledge.",
    "- A transcript has no slides, no diagrams and no code on screen, so if the speaker says “as you can see here”, that is a gap and you should name it.",
    "- Auto-generated transcripts have no punctuation and mis-hear names and technical terms. Read through that. Where a word is plainly a mis-transcription, say what you think was meant and mark it as a guess.",
    "- Quote sparingly and exactly, with the timestamp.",
    "",
    "THEIR QUESTION, if they asked one: {{question}}",
    "Answer it first and directly, before anything else.",
    "",
    "VIDEO: {{title}} — {{channel}}",
    "{{videoUrl}}",
    "",
    "TRANSCRIPT OF THE STRETCH",
    "{{transcript}}",
    "END"
  ]
}
